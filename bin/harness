#!/usr/bin/env bash
# powerharnessing11k: one-shot agentic-harness bootstrap for a git repository.
# https://github.com/AndyLan0503/powerharnessing11k
#
# It runs once per repository. It creates the files a team needs to work
# with coding agents and then steps away: nothing it writes refers back to it,
# and the team owns and maintains every file from then on.
set -eu
set -o pipefail

_self=$0
while [ -L "$_self" ]; do
  _link=$(readlink "$_self")
  case $_link in /*) _self=$_link ;; *) _self=$(dirname "$_self")/$_link ;; esac
done
HARNESS_ROOT=$(cd "$(dirname "$_self")/.." && pwd)
HARNESS_VERSION=$(cat "$HARNESS_ROOT/VERSION")
export HARNESS_ROOT HARNESS_VERSION

for _lib in util ui render apply settings agents detect modules custom wizard; do
  # shellcheck disable=SC1090
  . "$HARNESS_ROOT/lib/$_lib.sh"
done

usage() {
  cat <<EOF
$HARNESS_NAME $HARNESS_VERSION: one-shot agentic harness bootstrap for a git repository

Usage: setup.sh [configure] [options]    run the setup wizard (default)
       setup.sh list                     show profiles, tiers, and modules
       setup.sh version | help

It creates missing files and never touches existing ones (unless --force).
After the bootstrap the repository owns every file; $HARNESS_NAME is not
needed again.

Options:
  -C, --target DIR      Repository to bootstrap (default: current directory)
  -y, --yes             Non-interactive: accept detected defaults
  -n, --dry-run         Show what would be written without writing anything
  -f, --force           Overwrite files that already exist
      --local-only      Keep everything written out of git on this machine
                        (listed in .git/info/exclude; nothing to commit)
      --verbose         List every file written, not a summary
      --profile NAME    software | ml | agentic | study | research (default: software)
      --tier NAME       minimal | recommended | strict (default: recommended;
                        --preset is an alias, and "standard" means recommended)
      --stack NAME      node | python | go | rust | generic (default: detected)
      --modules LIST    Comma-separated modules (overrides the tier's list)
      --guard LEVEL     relaxed | standard | strict (overrides the tier's level)
      --agents LIST     Comma-separated coding agents: claude, codex, copilot (default: claude).
                        AGENTS.md is always written and is the source of truth
      --owners LIST     CODEOWNERS entries, e.g. "@acme/platform"
      --otel URL        OTLP endpoint; enables the telemetry module
      --artifacts       Version local data/model artifacts (artifacts.lock)
      --no-artifacts    Don't, even if the profile would
      --cmd KEY=CMD     Override a detected command (repeatable). KEY is one of
                        install, lint, typecheck, test, full-test, format, eval;
                        an empty CMD clears it. e.g. --cmd "test=uv run pytest -x"

Project-specific stubs (blank files with instructions for the team to fill in):
      --skills LIST     Skill names, e.g. "model-formulation,solver-tuning"
      --roles LIST      Subagent role names, e.g. "formulation-reviewer"
      --rules LIST      Path-scoped rules as name=glob[,glob], space-separated,
                        e.g. "solver=src/solver/** benchmarks=benchmarks/**"
      --dirs LIST       Extra directories to scaffold with a README, e.g. "infra"
EOF
}

# ---- argument parsing ------------------------------------------------------
CMD=configure
case ${1:-} in
  configure | init | list | version | help) CMD=$1; shift ;;
  -v | --version) CMD=version; shift ;;
  -h | --help) CMD=help; shift ;;
  '' | -*) ;;
  *) harness_die "unknown command: $1 (see: setup.sh help)" ;;
esac
TARGET=. YES='' DRY_RUN='' FORCE='' VERBOSE='' LOCAL_ONLY='' OPT_PROFILE='' OPT_TIER='' OPT_STACK='' OPT_MODULES=''
OPT_GUARD='' OPT_AGENTS='' OPT_OWNERS='' OPT_OWNERS_SET='' OPT_OTEL='' OPT_ARTIFACTS=''
OPT_SKILLS='' OPT_ROLES='' OPT_RULES='' OPT_DIRS='' OPT_CUSTOM_SET='' OPT_CMDS=''
while [ $# -gt 0 ]; do
  case $1 in
    -C | --target) TARGET=${2:?--target needs a value}; shift ;;
    -y | --yes) YES=1 ;;
    -n | --dry-run) DRY_RUN=1 ;;
    -f | --force) FORCE=1 ;;
    --verbose) VERBOSE=1 ;;
    --local-only) LOCAL_ONLY=1 ;;
    --profile) OPT_PROFILE=${2:?}; shift ;;
    --tier | --preset) OPT_TIER=${2:?}; shift ;;
    --stack) OPT_STACK=${2:?}; shift ;;
    --modules) OPT_MODULES=${2:?}; shift ;;
    --guard) OPT_GUARD=${2:?}; shift ;;
    --agents) OPT_AGENTS=${2:?}; shift ;;
    --owners) OPT_OWNERS=${2-}; OPT_OWNERS_SET=1; shift ;;
    --otel) OPT_OTEL=${2:?}; shift ;;
    --artifacts) OPT_ARTIFACTS=yes ;;
    --no-artifacts) OPT_ARTIFACTS=no ;;
    --skills) OPT_SKILLS=${2-}; OPT_CUSTOM_SET=1; shift ;;
    --roles) OPT_ROLES=${2-}; OPT_CUSTOM_SET=1; shift ;;
    --rules) OPT_RULES=${2-}; OPT_CUSTOM_SET=1; shift ;;
    --dirs) OPT_DIRS=${2-}; OPT_CUSTOM_SET=1; shift ;;
    --cmd)
      case ${2-} in
        install=* | lint=* | typecheck=* | test=* | full-test=* | format=* | eval=*) ;;
        *) harness_die "invalid --cmd '${2-}' (expected KEY=CMD; see: setup.sh help)" ;;
      esac
      OPT_CMDS="$OPT_CMDS$2
"
      shift
      ;;
    -h | --help) CMD=help ;;
    *) harness_die "unknown option: $1 (see: setup.sh help)" ;;
  esac
  shift
done
export DRY_RUN FORCE LOCAL_ONLY
ui_init

resolve_target() {
  [ -d "$TARGET" ] || harness_die "no such directory: $TARGET"
  TARGET=$(cd "$TARGET" && pwd)
  if git -C "$TARGET" rev-parse --show-toplevel >/dev/null 2>&1; then
    TARGET=$(git -C "$TARGET" rev-parse --show-toplevel)
  fi
  export TARGET
}

# The wizard runs inside the project to bootstrap. An empty folder is fine:
# offer to `git init` it (automatic with --yes). Refuse obviously wrong places.
ensure_git_repo() {
  case $TARGET in / | "$HOME") harness_die "refusing to set up $TARGET; cd into a project directory first" ;; esac
  git -C "$TARGET" rev-parse --show-toplevel >/dev/null 2>&1 && return 0
  if [ -z "$YES" ]; then
    printf '  %s is not a git repository. Initialize one here? [y/N] ' "$TARGET"
    local answer=''
    IFS= read -r answer <"$HARNESS_TTY" || answer=''
    case $answer in y | Y | yes) ;; *) harness_die "run setup inside a git repository (or answer y to create one)" ;; esac
  fi
  [ -n "$DRY_RUN" ] && return 0
  git -C "$TARGET" init -q
  git -C "$TARGET" symbolic-ref HEAD refs/heads/main
  ui_ok "Initialized an empty git repository in $TARGET (branch main)"
}

validate_answers() {
  list_has "$ALL_PROFILES" "${HV_PROFILE:-}" || harness_die "invalid profile: ${HV_PROFILE:-} (${ALL_PROFILES// /, })"
  case $HV_STACK in node | python | go | rust | generic) ;; *) harness_die "invalid stack: $HV_STACK" ;; esac
  case $HV_GUARD_LEVEL in relaxed | standard | strict) ;; *) harness_die "invalid guard level: $HV_GUARD_LEVEL" ;; esac
  agents_validate
  if [ -n "${HV_OTEL_ENDPOINT:-}" ] && ! list_has "$HV_AGENTS" claude; then
    harness_die "--otel sets up Claude Code's telemetry export, but Claude Code is not among the selected agents ($HV_AGENTS)"
  fi
  case $HV_DIFF_BUDGET in '' | *[!0-9]*) harness_die "DIFF_BUDGET must be a number" ;; esac
  custom_validate
  HV_MODULES=$(modules_normalize "$HV_MODULES")
  export HV_MODULES
}

# Apply flags given on the command line on top of the defaults.
apply_flag_overrides() {
  if [ -n "$OPT_STACK" ]; then
    HV_STACK=$OPT_STACK
    HV_PKG_MANAGER=$(detect_pkg_manager "$TARGET" "$HV_STACK")
    export HV_STACK HV_PKG_MANAGER
    stack_defaults
  fi
  if [ -n "$OPT_PROFILE$OPT_TIER" ]; then
    profile_load "${OPT_PROFILE:-$HV_PROFILE}" "${OPT_TIER:-recommended}"
  fi
  if [ -n "$OPT_MODULES" ]; then HV_MODULES=${OPT_MODULES//,/ }; fi
  [ -z "$OPT_GUARD" ] || HV_GUARD_LEVEL=$OPT_GUARD
  [ -z "$OPT_AGENTS" ] || HV_AGENTS=${OPT_AGENTS//,/ }
  [ -z "$OPT_OWNERS_SET" ] || HV_CODEOWNERS=$OPT_OWNERS
  if [ -n "$OPT_OTEL" ]; then
    HV_OTEL_ENDPOINT=$OPT_OTEL
    HV_MODULES="$HV_MODULES telemetry"
  fi
  case $OPT_ARTIFACTS in
    yes) HV_MODULES="$HV_MODULES artifacts" ;;
    no) HV_MODULES=$(printf ' %s ' "$HV_MODULES" | sed 's/ artifacts / /g') ;;
  esac
  local line key
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key=${line%%=*}
    case $key in
      install) HV_INSTALL_CMD=${line#*=} ;;
      lint) HV_LINT_CMD=${line#*=} ;;
      typecheck) HV_TYPECHECK_CMD=${line#*=} ;;
      test) HV_TEST_CMD=${line#*=} ;;
      full-test) HV_FULL_TEST_CMD=${line#*=} ;;
      format) HV_FORMAT_CMD=${line#*=} ;;
      eval) HV_EVAL_CMD=${line#*=} ;;
    esac
  done <<EOF
$OPT_CMDS
EOF
  export HV_INSTALL_CMD HV_LINT_CMD HV_TYPECHECK_CMD HV_TEST_CMD HV_FULL_TEST_CMD HV_FORMAT_CMD HV_EVAL_CMD
  if [ -n "$OPT_CUSTOM_SET" ]; then
    HV_SKILLS=${OPT_SKILLS//,/ } HV_ROLES=${OPT_ROLES//,/ } HV_RULES=$OPT_RULES HV_DIRS=${OPT_DIRS//,/ }
  fi
  export HV_MODULES HV_GUARD_LEVEL HV_AGENTS HV_CODEOWNERS HV_OTEL_ENDPOINT \
    HV_SKILLS HV_ROLES HV_RULES HV_DIRS
}

do_apply() {
  local m
  validate_answers
  derive_vars
  agents_export_vars
  apply_reset
  settings_reset
  agents_begin
  for m in $HV_MODULES; do module_run "$m"; done
  custom_apply
  agents_md_emit
  agents_finish

  printf '\n'
  [ -z "$DRY_RUN" ] || ui_warn "Dry run: nothing was written."
  if [ -n "$VERBOSE" ]; then apply_summary_full; else apply_summary; fi
  printf '\n'
  if [ "$APPLY_SKIPPED" -gt 0 ]; then
    ui_warn "Existing files were left as they are. Use --force to overwrite them."
  fi
  if [ -n "$LOCAL_ONLY" ]; then
    apply_local_exclude
    if [ -n "$DRY_RUN" ]; then
      ui_info "${C_BOLD}Local only:${C_RESET} $LOCAL_EXCLUDED file(s) would be kept out of git on this machine (listed in ${LOCAL_EXCLUDE_FILE#"$TARGET"/})."
    else
      ui_info "${C_BOLD}Local only:${C_RESET} $LOCAL_EXCLUDED file(s) are kept out of git on this machine (listed in ${LOCAL_EXCLUDE_FILE#"$TARGET"/})."
    fi
    [ -z "$LOCAL_TRACKED" ] || ui_warn "Already tracked by git, so they cannot be ignored:$LOCAL_TRACKED"
    printf '\n'
  elif local_block_present; then
    ui_warn "An earlier --local-only run still hides its files from git on this machine. To commit them, delete the marked block in $(git -C "$TARGET" rev-parse --git-path info/exclude)."
    printf '\n'
  fi
}

next_steps() {
  [ -z "$DRY_RUN" ] || return 0
  local n=1
  ui_ok "Bootstrapped $TARGET"
  printf '\n'
  ui_info "${C_BOLD}Next steps${C_RESET} (everything written is now yours; $HARNESS_NAME is not needed again)"
  local todos f
  todos=$(apply_todo_files)
  if [ -n "$todos" ]; then
    ui_info "  $n. Fill in the TODO(team) notes in these files (find them again with: grep -rl 'TODO(team)' .)"
    while IFS= read -r f; do ui_info "       ${C_DIM}$f${C_RESET}"; done <<EOF
$todos
EOF
    n=$((n + 1))
  fi
  if [ -n "$HV_SCAFFOLD_PYTHON" ]; then
    ui_info "  $n. make setup && make check     (installs dev tools with uv, then runs every fast check)"
    n=$((n + 1))
  fi
  if [ -n "$LOCAL_ONLY" ]; then
    ui_info "  $n. Nothing to commit: this setup stays on this machine. Your agents use it as usual."
    ui_info "       ${C_DIM}CI workflows and anything read from the default branch (such as Copilot's cloud agent) only work once committed.${C_RESET}"
    ui_info "       ${C_DIM}To share it later, delete the marked block in ${LOCAL_EXCLUDE_FILE#"$TARGET"/}, then commit.${C_RESET}"
    n=$((n + 1))
  else
    ui_info "  $n. Review, commit, and open a PR:  git add -A && git commit -m 'chore: bootstrap agent harness'"
    n=$((n + 1))
  fi
  if [ -z "$LOCAL_ONLY" ] && list_has "$HV_MODULES" ci; then
    ui_info "  $n. Protect '$HV_DEFAULT_BRANCH': require PR review and the CI checks (Settings → Branches)"
    n=$((n + 1))
  fi
  if [ -z "$LOCAL_ONLY" ] && list_has "$HV_MODULES" review; then
    ui_info "  $n. Add the ANTHROPIC_API_KEY repository secret for the Claude workflows"
    n=$((n + 1))
  fi
  local a step
  for a in $HV_AGENTS; do
    step=$(agent_field "$a" NEXT_STEP)
    [ -n "$step" ] || continue
    ui_info "  $n. $step"
    n=$((n + 1))
  done
}

cmd_configure() {
  resolve_target
  ensure_git_repo
  harness_tmpdir >/dev/null
  HV_PROJECT_NAME=$(basename "$TARGET")
  HV_DEFAULT_BRANCH=$(detect_default_branch "$TARGET")
  HV_STACK=$(detect_stack "$TARGET")
  HV_PKG_MANAGER=$(detect_pkg_manager "$TARGET" "$HV_STACK")
  HV_AGENTS=claude HV_CODEOWNERS='' HV_OTEL_ENDPOINT='' HV_DIFF_BUDGET=800 HV_EVAL_CMD=''
  HV_SKILLS='' HV_ROLES='' HV_RULES='' HV_DIRS=''
  export HV_PROJECT_NAME HV_DEFAULT_BRANCH HV_STACK HV_PKG_MANAGER HV_AGENTS \
    HV_CODEOWNERS HV_OTEL_ENDPOINT HV_DIFF_BUDGET HV_EVAL_CMD HV_SKILLS HV_ROLES HV_RULES HV_DIRS
  stack_defaults
  profile_load software recommended
  apply_flag_overrides

  if [ -e "$TARGET/AGENTS.md" ] && [ -z "$FORCE" ]; then
    ui_warn "This repository already has AGENTS.md: existing files will be kept and only missing ones created."
  fi
  if [ -z "$YES" ]; then
    if ! { : <"$HARNESS_TTY"; } 2>/dev/null; then
      harness_die "no terminal for the wizard; pass --yes for non-interactive setup"
    fi
    wizard_run
    ui_clear
    ui_banner
  else
    ui_info "${C_BOLD}$HARNESS_NAME${C_RESET} $HARNESS_VERSION → $TARGET  ${C_DIM}($HV_PROFILE, $HV_STACK, $HV_GUARD_LEVEL)${C_RESET}"
  fi
  do_apply
  next_steps
}

cmd_list() {
  local m p t
  ui_info "${C_BOLD}Profiles${C_RESET}  (--profile)"
  for p in $ALL_PROFILES; do
    printf '  %-10s %s\n' "$p" "$(profile_field "$p" TITLE): $(profile_field "$p" DESC)"
  done
  printf '\n'
  ui_info "${C_BOLD}Tiers${C_RESET}  (--tier): modules per profile"
  for p in $ALL_PROFILES; do
    for t in MINIMAL RECOMMENDED STRICT; do
      printf '  %-10s %-12s %s\n' "$p" "$(printf '%s' "$t" | tr 'A-Z' 'a-z')" "$(profile_field "$p" "$t")"
    done
  done
  printf '\n'
  ui_info "${C_BOLD}Modules${C_RESET}"
  for m in $ALL_MODULES; do printf '  %-12s %s\n' "$m" "$(module_desc "$m")"; done
}

case $CMD in
  configure | init) cmd_configure ;;
  list) cmd_list ;;
  version) echo "$HARNESS_NAME $HARNESS_VERSION" ;;
  help) usage ;;
esac
