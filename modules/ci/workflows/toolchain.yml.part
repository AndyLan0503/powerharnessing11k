{{#if STACK_NODE}}
{{#if PM_PNPM}}
      - uses: pnpm/action-setup@v4
{{/if}}
{{#if PM_BUN}}
      - uses: oven-sh/setup-bun@v2
{{/if}}
      - uses: actions/setup-node@v4
        with:
          node-version: lts/*
{{#unless PM_BUN}}
          # The dependency cache needs a lockfile; a new project has none yet.
          cache: ${{ hashFiles('{{NODE_LOCKFILE}}') != '' && '{{PKG_MANAGER}}' || '' }}
{{/if}}
{{/if}}
{{#if STACK_PYTHON}}
{{#if PM_UV}}
      - uses: astral-sh/setup-uv@v6
        with:
          enable-cache: true
{{/if}}
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
{{#if PM_POETRY}}
      - run: pipx install poetry
{{/if}}
{{/if}}
{{#if STACK_GO}}
      - uses: actions/setup-go@v5
        if: ${{ {{CI_HAS_PROJECT}} }}
        with:
          go-version-file: go.mod
{{/if}}
{{#if STACK_RUST}}
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt
      - uses: Swatinem/rust-cache@v2
{{/if}}
{{#if INSTALL_CMD}}
      - name: Install
{{#if CI_HAS_PROJECT}}
        # Skipped until the project exists (its manifest is committed).
        if: ${{ {{CI_HAS_PROJECT}} }}
{{/if}}
        run: |
{{#if USE_MAKE}}
          make setup
{{/if}}
{{#unless USE_MAKE}}
          {{INSTALL_CMD}}
{{/if}}
{{/if}}
